{
  "uid": "real-records",
  "title": "Real records operations",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "API scrape health",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "expr": "up{job=\"real-records-api\"}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Imported records / second",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 16,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by(kind) (rate(real_records_imported_total[5m]))",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "API memory",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "process_resident_memory_bytes{job=\"real-records-api\"}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "API latency p95 (seconds)",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by(le) (rate(real_records_http_request_seconds_bucket[5m])))"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Records waiting for projection",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "expr": "real_records_projection_pending"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "API failures / second",
      "gridPos": {
        "x": 8,
        "y": 16,
        "w": 16,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(real_records_http_requests_total{status=~\"5..\"}[5m]))"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Worker heartbeat age (seconds)",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "expr": "time() - real_records_worker_seen_timestamp",
          "legendFormat": "{{service}}"
        }
      ]
    }
  ]
}
